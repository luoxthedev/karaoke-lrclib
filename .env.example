# ------------------------------------------------------------------
# Audius — https://audius.co/settings → "Manage Your Apps" → créer une app
# puis copier la clé API (lecture seule) dans .env.local :
#
#   NEXT_PUBLIC_AUDIUS_API_KEY=votre_cle_ici
#
# La doc Audius autorise l'exposition de la clé *lecture seule* côté
# client (elle sert au repli direct navigateur → api.audius.co).
# Ne JAMAIS exposer un éventuel API Secret : il resterait serveur uniquement.
# ------------------------------------------------------------------

NEXT_PUBLIC_AUDIUS_API_KEY=

# Optionnel : clé prioritaire côté serveur (routes /api/*) —
# pratique pour ne pas rebuilder quand la clé change.
# AUDIUS_API_KEY=

# Optionnel : nom d'application envoyé en ?app_name= (défaut: karaoke-lrclib)
# AUDIUS_APP_NAME=karaoke-lrclib
